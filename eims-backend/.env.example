# 复制为 .env 后按需修改（或通过系统环境变量注入）
# 本地开发默认 profile=dev，可不设置以下变量

# SPRING_PROFILES_ACTIVE=dev

# 数据库（dev 默认值见 application-dev.yml）
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=eims
# DB_USERNAME=root
# DB_PASSWORD=123456

# JWT（dev 有默认值，生产必须设置）
# JWT_SECRET=your-production-secret-at-least-32-chars
# JWT_EXPIRATION=86400000

# CORS 允许的前端地址，多个用逗号分隔
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# ---------- 生产环境示例 ----------
# SPRING_PROFILES_ACTIVE=prod
# DB_URL=jdbc:mysql://db-host:3306/eims?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=true
# DB_USERNAME=eims
# DB_PASSWORD=strong-password
# JWT_SECRET=your-production-secret-at-least-32-chars
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
# SERVER_PORT=8080
